# --- Model weights (never committed: hundreds of MB, exceeds GitHub's 100 MB limit) ---
*.gguf
*.safetensors
*.bin
*.pt

# --- Upstream llama.cpp checkout (cloned by scripts/setup.sh, not vendored) ---
/llama.cpp/

# --- Local deployment runtime state (pid, log, metadata from deploy.sh) ---
/.run/

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/

# --- OS / editor ---
.DS_Store
.vscode/
.idea/

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Keep the model download target present in a fresh clone ---
!models/.gitkeep